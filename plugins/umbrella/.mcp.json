{
  "mcpServers": {
    "umbraco": {
      "command": "npx",
      "args": ["-y", "umbrella-mcp@18.1.1"],
      "env": {
        "UMBRACO_BASE_URL": "${user_config.base_url}",
        "UMBRACO_CLIENT_ID": "${user_config.client_id}",
        "UMBRACO_CLIENT_SECRET": "${user_config.client_secret}",
        "NODE_TLS_REJECT_UNAUTHORIZED": "${user_config.tls_reject_unauthorized}"
      }
    }
  }
}
