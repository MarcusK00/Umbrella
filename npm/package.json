{
  "name": "umbrella-mcp",
  "version": "17.0.0-alpha.8",
  "description": "One MCP server for your Umbraco 17 site: loads the tools for the Umbraco products the site has installed.",
  "keywords": [
    "umbraco",
    "mcp",
    "model-context-protocol",
    "ai"
  ],
  "license": "MIT",
  "homepage": "https://www.nuget.org/packages/Umbraco.Community.Umbrella",
  "bugs": {
    "url": "https://github.com/MarcusK00/Umbrella-Issues/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarcusK00/Umbrella.git",
    "directory": "npm"
  },
  "type": "module",
  "bin": {
    "umbrella-mcp": "./dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "compile": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "list-tools": "node --env-file=.env dist/index.js --list-tools",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@umbraco-automate/mcp-dev": "17.4.0-beta.5",
    "@umbraco-cms/mcp-dev": "17.6.12",
    "@umbraco-cms/mcp-server-sdk": "1.0.0-beta.47",
    "@umbraco-engage/mcp-dev": "17.0.0-beta.5",
    "@umbraco-forms/mcp-dev": "17.6.1-beta.6",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@umbraco-cms/mcp-server-sdk": "$@umbraco-cms/mcp-server-sdk"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
